# Modelo das variáveis de ambiente do unidash-back.
# Copie para .env e preencha. NUNCA coloque valores reais neste arquivo:
# ele vai para o git. No CapRover, as mesmas variáveis ficam no painel do app.

# Ambiente: dev, hml ou prd
AMBIENTE=dev

# Banco de aplicação (schema unidash; leitura do schema app do UniData)
DB_HOST=
DB_PORT=5432
DB_NAME=unidata_hml
DB_USER=
DB_PASSWORD=

# --- As variáveis abaixo entram nas próximas etapas ---

# DW do UniData, só leitura (etapa 6)
# DW_HOST=
# DW_PORT=5432
# DW_NAME=unidata_dw_hml
# DW_USER=
# DW_PASSWORD=

# Redis: cache dos endpoints e controle de tokens já usados (etapas 6 e 7)
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Entrada pelo portal UniData (área do time de dados)
# PORTAL_INGRESSO_SECRET: segredo combinado com o UniData (mesmo valor de
#   UNIDASH_INGRESSO_SECRET no back do UniData). Mínimo de 32 caracteres.
# SESSAO_SECRET: segredo só do UniDash, assina a sessão de trabalho. Mínimo de 32 caracteres.
# Para gerar um segredo: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_INGRESSO_SECRET=
PORTAL_URL=
SESSAO_SECRET=
SESSAO_HORAS=8

# Integração com o Hub (link de embed). Ver docs/integracao-hub.md
# EMBED_HUB_ORIGIN: origem do Hub (hml: https://unifecaf-hub-hml.app.unifecaf.edu.br).
#   No computador, com o Hub simulado (scripts/hub_simulado.py): http://localhost:5174
# EMBED_HUB_SECRET: segredo combinado com o dono do Hub, um por ambiente. Mínimo de 32 caracteres.
#   Nunca por chat ou e-mail aberto.
# EMBED_SESSAO_MINUTOS: duração da sessão de um dashboard aberto pelo Hub.
# A sessão do embed é assinada com o SESSAO_SECRET (acima).
EMBED_HUB_ORIGIN=
EMBED_HUB_SECRET=
EMBED_SESSAO_MINUTOS=30
